<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ package visibility: without this the module's own process
      cannot see the host package at all, which silently breaks the version
      read (NameNotFoundException) and with it the NT/generation detection in
      the settings screen. The host process itself runs under QQ's uid and is
      unaffected.
    -->
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.mobileqqi" />
        <package android:name="com.tencent.qqlite" />
        <package android:name="com.tencent.minihd.qq" />
        <package android:name="com.tencent.tim" />
    </queries>


    <application
        android:allowBackup="false"
        android:description="@string/xposeddescription"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qself">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- module entry in the framework's list -->
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <!-- launcher icon: the settings screen is also the app's UI -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required by MainActivity to pick the host package in the UI. -->
        <meta-data
            android:name="qself.host"
            android:value="com.tencent.mobileqq" />
    </application>

</manifest>
